# Paths and Slurm settings for the Sensors revision runs.
# This is the ONLY file that should need editing. Every script sources it.
# Check each line against the cluster before the first run (00_preflight.sh
# reports what it finds).

# --- what to run ------------------------------------------------------------
export DATE=2025-08-13            # data snapshot of the published runs
export PREPROC=norm_on            # preprocessing variant of the published runs
export SMOKE=0                    # 1 = tiny CV/grids to test the chain; results are NOT usable

# --- inputs -----------------------------------------------------------------
# Group directory with the raw recordings and the metadata CSVs
# (merged_metadata.csv, comorbidities.csv, psm_matched_charite.csv,
#  uk_matched_metadata.csv, uk_matched_metadata_ps_covariates.csv).
export RAW_DIR=/data/cephfs-1/work/groups/mittermaier/stimmaufnahmen/$DATE
# Features and MLflow runs of the published analysis (Johann's former account).
# Used only if readable; otherwise the features are rebuilt under NEW_FEATURES_BASE.
export OLD_FEATURES_BASE=/data/cephfs-1/home/users/joli13_c/work/pipeline_features/$DATE
export OLD_MLFLOW=/data/cephfs-1/home/users/joli13_c/work/mlflow
# Where rebuilt features go (persistent storage, not scratch: scratch is purged after 14 days)
export NEW_FEATURES_BASE=$HOME/work/pipeline_features/$DATE
# Force a feature directory (skip the automatic choice). Leave empty normally.
export FEATURES_BASE_OVERRIDE=

# --- outputs ----------------------------------------------------------------
# All runs, logs and analysis outputs. Stays on the cluster; only the
# aggregate files copied by 50_collect.sh leave it.
export OUT=$HOME/work/revision_sensors_r1

# --- caches (home quota is small; keep caches on work) ----------------------
export UV_CACHE_DIR=$HOME/work/.cache/uv
export HF_HOME=$HOME/work/.cache/huggingface

# --- Slurm ------------------------------------------------------------------
# Extra sbatch arguments per job type. Adjust partition names to the cluster
# (`sinfo -s` lists them). Time limits are set in each .sbatch file.
export SBATCH_CPU_ARGS=""
export SBATCH_GPU_ARGS="--partition=gpu --gres=gpu:1"
